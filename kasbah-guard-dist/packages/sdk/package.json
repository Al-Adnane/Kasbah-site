{
  "name": "@kasbah/guard",
  "version": "1.0.0",
  "description": "Kasbah Guard — universal sensitive data detection SDK (Node.js, browser, edge runtimes)",
  "keywords": ["privacy", "data-protection", "dlp", "pii", "secrets", "ai-safety"],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./node": {
      "import": "./dist/node.js",
      "require": "./dist/node.cjs",
      "types": "./dist/node.d.ts"
    },
    "./browser": {
      "import": "./dist/browser.js",
      "types": "./dist/browser.d.ts"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc && node build.mjs",
    "dev": "tsc --watch",
    "test": "node --experimental-vm-modules node_modules/.bin/jest"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "esbuild": "^0.20.0"
  },
  "engines": { "node": ">=18" }
}
