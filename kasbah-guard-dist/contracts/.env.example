# Smart Contract Deployment Configuration
# Copy this file to .env and fill in your actual values

# Network RPC URLs
MUMBAI_RPC_URL=https://rpc-mumbai.maticvigil.com
POLYGON_RPC_URL=https://polygon-rpc.com

# Deployment account private key (WITHOUT 0x prefix)
# ⚠️ NEVER commit .env with real private keys to git
PRIVATE_KEY=

# Etherscan/PolygonScan API key for contract verification
POLYGONSCAN_API_KEY=

# Deployed contract address (filled after deployment)
CONTENT_PASSPORT_REGISTRY=
