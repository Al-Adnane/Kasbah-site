{
  "manifest_version": 3,
  "name": "Kasbah Guard - Social Media",
  "version": "1.0.0",
  "description": "Kasbah Guard protection for social media platforms - Twitter, Facebook, Instagram, TikTok, YouTube",
  "permissions": [
    "activeTab",
    "storage",
    "webRequest"
  ],
  "host_permissions": [
    "*://twitter.com/*",
    "*://x.com/*",
    "*://facebook.com/*",
    "*://instagram.com/*",
    "*://tiktok.com/*",
    "*://youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://twitter.com/*",
        "*://x.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    },
    {
      "matches": [
        "*://facebook.com/*",
        "*://www.facebook.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    },
    {
      "matches": [
        "*://instagram.com/*",
        "*://www.instagram.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    },
    {
      "matches": [
        "*://tiktok.com/*",
        "*://www.tiktok.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    },
    {
      "matches": [
        "*://youtube.com/*",
        "*://www.youtube.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_title": "Kasbah Guard - Social Media",
    "default_icon": {
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["icon*.png"],
      "matches": ["<all_urls>"]
    }
  ]
}
