{
  "manifest_version": 3,
  "name": "Kasbah Guard",
  "version": "1.0.0",
  "description": "AI-powered data loss prevention and secret detection - Local-first AI security",
  "permissions": [
    "activeTab",
    "storage",
    "webRequest",
    "webNavigation",
    "tabs",
    "clipboardRead",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ],
  "action": {
    "default_popup": "src/popup.html",
    "default_icon": {
      "48": "icon48.png",
      "128": "icon128.png"
    },
    "default_title": "Kasbah Guard"
  },
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self' https://api.bekasbah.com https://bekasbah.com https://api.kasbah.ai https://*.kasbah.ai; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' https: data:; default-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": ["src/*.js", "icon*.png", "assets/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "guard@bekasbah.com",
      "strict_min_version": "109.0"
    }
  },
  "author": "Kasbah Security",
  "homepage_url": "https://bekasbah.com"
}
