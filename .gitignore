**/*.bak_*
**/*.backup

# Wrangler build cache
.wrangler/
**/.wrangler/

# Extension zips (built from source)
kasbah-guard-dist/kasbah-*.zip

# Screenshots (dev only)
kasbah-guard-dist/chrome-store-screenshots/

# Logo source
kasbah-guard-dist/logo-source-*.png

