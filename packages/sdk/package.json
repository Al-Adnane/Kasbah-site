{
  "name": "@kasbah/guard",
  "version": "1.0.0",
  "description": "Universal JavaScript SDK for Kasbah Guard secret detection",
  "author": "Kasbah Guard <team@bekasbah.com>",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && esbuild src/index.ts --bundle --outfile=dist/index.mjs --format=esm",
    "test": "jest",
    "types": "tsc --emitDeclarationOnly",
    "prepublish": "npm run build && npm run test"
  },
  "keywords": [
    "security",
    "secrets",
    "detection",
    "credentials",
    "api-keys",
    "privacy"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Al-Adnane/Kasbah-site"
  },
  "bugs": {
    "url": "https://github.com/Al-Adnane/Kasbah-site/issues"
  },
  "homepage": "https://bekasbah.com",
  "engines": {
    "node": ">=14.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "esbuild": "^0.19.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0"
  }
}
